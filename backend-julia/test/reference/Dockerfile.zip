FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
WORKDIR /reference
COPY requirements-zip.txt /reference/
RUN pip install --no-cache-dir --only-binary=:all: --no-deps -r requirements-zip.txt && pip check
COPY generate_zip.py ac-networks-v1.json /reference/
ENTRYPOINT ["python", "/reference/generate_zip.py"]
