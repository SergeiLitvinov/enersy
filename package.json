{
  "name": "enersy-documentation",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "docs:generate": "node scripts/docs/generate.mjs && typedoc",
    "docs:dev": "pnpm docs:generate && vitepress dev docs/site --host 127.0.0.1",
    "docs:build": "pnpm docs:test && pnpm docs:generate && vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site --host 0.0.0.0 --port 4173",
    "docs:test": "node --test scripts/docs/*.test.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
